# --- API config (PoC) ---

# SQLite DB file (design.md §3.1.1)
DATABASE_URL="file:./dev.db"

# HMAC secret used to sign store QR codes (design.md §2.9).
# Verifies a QR is an official store code; NOT a per-scan secret.
STORE_QR_SECRET="poc-dev-store-qr-secret-change-me"

# API port
PORT=3000

# Allowed web origin for CORS + cookies
WEB_ORIGIN="http://localhost:5173"
